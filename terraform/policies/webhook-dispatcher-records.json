[
  {
    "Sid": "FindDueOwners",
    "Effect": "Allow",
    "Action": [
      "dynamodb:Query"
    ]
  },
  {
    "Sid": "ReadWriteWebhookRows",
    "Effect": "Allow",
    "Action": [
      "dynamodb:GetItem",
      "dynamodb:PutItem"
    ],
    "Condition": {
      "ForAllValues:StringLike": {
        "dynamodb:LeadingKeys": [
          "WEBHOOK#*"
        ]
      },
      "Null": {
        "dynamodb:LeadingKeys": "false"
      }
    }
  }
]
