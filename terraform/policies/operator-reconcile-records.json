[
  {
    "Sid": "ReadOwnedRecords",
    "Effect": "Allow",
    "Action": [
      "dynamodb:GetItem"
    ],
    "Condition": {
      "ForAllValues:StringLike": {
        "dynamodb:LeadingKeys": [
          "OWNER#*"
        ]
      },
      "Null": {
        "dynamodb:LeadingKeys": "false"
      }
    }
  },
  {
    "Sid": "ReconcileOwnedJobAndAudit",
    "Effect": "Allow",
    "Action": [
      "dynamodb:PutItem"
    ],
    "Condition": {
      "ForAllValues:StringLike": {
        "dynamodb:LeadingKeys": [
          "OWNER#*"
        ]
      },
      "Null": {
        "dynamodb:LeadingKeys": "false"
      }
    }
  }
]
