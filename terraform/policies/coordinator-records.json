[
  {
    "Sid": "ReadRecords",
    "Effect": "Allow",
    "Action": [
      "dynamodb:GetItem"
    ]
  },
  {
    "Sid": "WriteOwnedJobs",
    "Effect": "Allow",
    "Action": [
      "dynamodb:PutItem"
    ],
    "Condition": {
      "ForAllValues:StringLike": {
        "dynamodb:LeadingKeys": [
          "OWNER#*",
          "WEBHOOK#*"
        ]
      },
      "Null": {
        "dynamodb:LeadingKeys": "false"
      }
    }
  }
]
