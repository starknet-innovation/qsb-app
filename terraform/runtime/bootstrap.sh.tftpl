#!/bin/bash
set -euo pipefail
umask 077
install -d -m 0700 /etc/qsb /var/lib/qsb /evidence
printf '%s' '${config_b64}' | base64 -d > /etc/qsb/host.json
printf '%s' '${preflight_b64}' | base64 -d > /usr/local/sbin/qsb-host-preflight
chmod 0700 /usr/local/sbin/qsb-host-preflight
# No package downloads, credentials, dispatcher start or provider requests at boot.
# Dedicated volume attachment is asynchronous. Check the exact Nitro volume serial.
device='/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${volume_serial}'
for attempt in $(seq 1 120); do
  if test -b "$device"; then break; fi
  sleep 5
done
test -b "$device"
type=$(blkid -s TYPE -o value "$device" || true)
if test -z "$type"; then
  test -z "$(wipefs --noheadings --output TYPE "$device")"
  mkfs.ext4 -q "$device"
elif test "$type" != ext4; then
  echo 'Unexpected evidence filesystem; refusing modification' >&2
  exit 1
fi
uuid=$(blkid -s UUID -o value "$device")
grep -q "UUID=$uuid " /etc/fstab || printf 'UUID=%s /evidence ext4 defaults,nosuid,nodev,noexec 0 2\n' "$uuid" >> /etc/fstab
if ! mountpoint -q /evidence; then
  test -z "$(find /evidence -mindepth 1 -maxdepth 1 -print -quit)"
  mount /evidence
fi
test "$(findmnt -no UUID /evidence)" = "$uuid"
chmod 0700 /evidence
# Both units stay masked even when the infrastructure is provisioned.
# A later reviewed activation must install the complete dispatcher and its exact release.
systemctl mask qsb-dispatch.service qsb-runtime.service
printf 'Infrastructure prepared; execution disabled. Run qsb-host-preflight after package installation.\n'
