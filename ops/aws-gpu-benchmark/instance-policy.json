{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SessionManagerOnly",
      "Effect": "Allow",
      "Action": ["ssm:UpdateInstanceInformation", "ssmmessages:CreateControlChannel", "ssmmessages:CreateDataChannel", "ssmmessages:OpenControlChannel", "ssmmessages:OpenDataChannel"],
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherAwsAccess",
      "Effect": "Deny",
      "NotAction": ["ssm:UpdateInstanceInformation", "ssmmessages:CreateControlChannel", "ssmmessages:CreateDataChannel", "ssmmessages:OpenControlChannel", "ssmmessages:OpenDataChannel"],
      "Resource": "*"
    }
  ]
}
