FROM nvidia/cuda:12.8.1-devel-ubuntu22.04@sha256:6617a625f4090c76c545a0e7d63f2e441718ef9af7f4efe7dd1242a29e289fd7
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev python3 && rm -rf /var/lib/apt/lists/*
COPY source /candidate
WORKDIR /candidate
RUN nvcc -O3 -arch=sm_89 -std=c++17 pinning/pinning.cu -o /pinning -lcrypto -lm
RUN nvcc -O3 -arch=sm_89 -std=c++17 subset/subset.cu -o /subset -lcrypto -lm
RUN (nvcc --version; sha256sum /pinning /subset; dpkg-query -W gcc g++ libssl-dev) > /compile-receipt.txt
# Compile only. These benchmark binaries are not application releases or executed.
ENTRYPOINT ["cat", "/compile-receipt.txt"]
